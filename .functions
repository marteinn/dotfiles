# Create a new directory and enter it
function mkd() {
    mkdir -p "$@" && cd "$@"
}

# Serve static web assets
function simple_webserver {
    python3 -m http.server 8001
}

# Create new tmux session by folder name
function tnew {
    tmux new-session -As `(basename $PWD | tr . _)`
}

# Initialize nvm
function nvm_session() {
    if [[ "$OSTYPE" == "darwin"* ]]; then
        export NVM_DIR=~/.nvm
        source $(brew --prefix nvm)/nvm.sh
    else
        export NVM_DIR="$([ -z "${XDG_CONFIG_HOME-}" ] && printf %s "${HOME}/.nvm" || printf %s "${XDG_CONFIG_HOME}/nvm")"
        [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh" # This loads nvm
    fi

    nvm use
}

# Initialize rbenv
function rbenv_session() {
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(rbenv init - zsh)"
    else
        eval "$(rbenv init - bash)"
    fi
}

# Initialize mise
function mise_session() {
    if [ -n "$ZSH_VERSION" ]; then
        eval "$(mise activate zsh)"
    else
        eval "$(mise activate bash)"
    fi
}

# Refresh Cloudflare Zero Trust CA Bundle
function refresh_ca_bundle() {
    local out="${HOME}/.certs/macos-ca-bundle.pem"
    mkdir -p "$(dirname "$out")"
    security find-certificate -a -p \
        /System/Library/Keychains/SystemRootCertificates.keychain >| "$out"
    security find-certificate -a -p /Library/Keychains/System.keychain >> "$out"
    echo "Wrote $(grep -c 'BEGIN CERT' "$out") certificates to $out"
}
